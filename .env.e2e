# E2E テスト専用（npm run test:e2e）。Firebase Emulator の demo プロジェクトに接続する。
# 実在のプロジェクト・秘密情報は含まない。.env.local より優先される。
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-jotbound.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-jotbound
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APPCHECK_DEBUG=false
VITE_USE_EMULATORS=true
VITE_GOOGLE_BOOKS_API_KEY=
