# Jotbound の設定ファイルのひな形です。`npm run setup` を実行すると、これをもとに .env.local が作られます。
# 手で作る場合は .env.local にコピーして値を書いてください。.env.local はコミットしないでください。

# ---- Firebase の Web 設定（npm run setup が自動で書き込みます） ----
# 公開されても問題のない識別子です。アクセスの可否は Security Rules と App Check で決まります。
VITE_FIREBASE_API_KEY=
# アプリを配信するドメイン（<プロジェクトID>.web.app）にします。PWA・iPhone でのログインに必要です。
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---- App Check（AI 解析に必須）: reCAPTCHA のキー ID（サイトキー） ----
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# ---- Google Books API キー（任意）: 書名検索に使います。未設定なら手入力で登録します ----
VITE_GOOGLE_BOOKS_API_KEY=

# ---- 所有者の UID（推奨）: `npm run owner:set -- <UID>` で設定します ----
# デプロイ時に Security Rules へ差し込まれ、このアカウント以外はデータにアクセスできなくなります。
# アプリには含まれません（VITE_ で始まらない値はビルドに入りません）。
OWNER_UIDS=

# ---- 開発用（本番では false のまま） ----
# true にすると App Check のデバッグトークンがブラウザのコンソールに出ます。本番ビルドでは無視されます。
VITE_APPCHECK_DEBUG=false
# 開発・テスト専用: Firebase Emulator に接続します。
VITE_USE_EMULATORS=false
